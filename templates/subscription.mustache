{{!
    @template local_dteachwhiteboard/subscription

    Subscription state of this site and the actions that move it along.

    Context variables required for this template:
    * statelabel string - short name of the current state
    * statevariant string - bootstrap colour suffix for the state badge
    * summary string - one sentence describing the current state
    * details array - label/value pairs describing the plan and the site
    * toolready string - shown when teachers can open a whiteboard, empty otherwise
    * keyform object - the licence key form, false unless this site is waiting for a key
    * connectsteps string - title of the steps list, empty unless the site is unconnected
    * steps array - what activating the licence key does, in order
    * actions string - rendered buttons and links

    Example context (json):
    {
        "statelabel": "Not connected",
        "statevariant": "secondary",
        "summary": "This site is not connected yet.",
        "details": [
            {"label": "Site", "value": "https://moodle.example.com"}
        ],
        "toolready": "",
        "keyform": {
            "formurl": "/local/dteachwhiteboard/subscription.php",
            "sesskey": "abcd1234",
            "label": "Licence key",
            "help": "The key emailed to you when you bought the whiteboard.",
            "submit": "Activate"
        },
        "connectsteps": "",
        "steps": [],
        "actions": "<a class=\"btn btn-link\" href=\"#\">View on Moodle Marketplace</a>"
    }
}}
<div class="card mb-3">
    <div class="card-body">
        <span class="badge badge-{{statevariant}} bg-{{statevariant}}">{{statelabel}}</span>
        <p class="lead mt-2 mb-3">{{summary}}</p>
        <dl class="row mb-0">
            {{#details}}
                <dt class="col-sm-3">{{label}}</dt>
                <dd class="col-sm-9">{{value}}</dd>
            {{/details}}
        </dl>
        {{#toolready}}
            <div class="alert alert-success mb-0 mt-3" role="status">{{toolready}}</div>
        {{/toolready}}
        {{#keyform}}
            <form method="post" action="{{formurl}}" class="mt-3">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="activate">
                <div class="form-group mb-3">
                    <label for="local-dteachwhiteboard-licencekey">{{label}}</label>
                    <input type="text" class="form-control" id="local-dteachwhiteboard-licencekey"
                        name="licencekey" size="40" autocomplete="off" spellcheck="false" required>
                    <small class="form-text text-muted">{{help}}</small>
                </div>
                <button type="submit" class="btn btn-primary">{{submit}}</button>
            </form>
        {{/keyform}}
    </div>
    <div class="card-footer d-flex flex-wrap align-items-center">
        {{{actions}}}
    </div>
</div>
{{#connectsteps}}
    <div class="card mb-3">
        <div class="card-body">
            <h3 class="h5">{{connectsteps}}</h3>
            <ol class="mb-0">
                {{#steps}}
                    <li>{{.}}</li>
                {{/steps}}
            </ol>
        </div>
    </div>
{{/connectsteps}}
